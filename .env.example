# Clave gratuita en https://the-odds-api.com (500 peticiones/mes en plan free).
# Sin clave la app usa las cuotas de ESPN (sin player props de casas de apuestas).
ODDS_API_KEY=

# Regiones de casas de apuestas para The Odds API: eu, uk, us, au (separadas por coma)
ODDS_REGIONS=eu

# Bankroll para calcular el stake sugerido (criterio de Kelly fraccional)
BANKROLL=100
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03

# Valor esperado mínimo para recomendar una apuesta (0.03 = 3%)
MIN_EDGE=0.03

# Peso del modelo frente al mercado (0 = solo mercado, 1 = solo modelo)
MODEL_WEIGHT=0.5

# Activar scraping de sportsgambler.com y scores24.live (1/0)
ENABLE_SCRAPERS=1

# Máximo de jugadores a analizar para props por partido (cada uno = llamadas a stats.nba.com)
MAX_PROP_PLAYERS=8
